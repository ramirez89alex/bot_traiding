# Copia este archivo a .env y completa tus valores. Nunca subas .env al repositorio.

# ── Binance (cripto) — https://testnet.binance.vision ──────────────────────
# Para paper trading NO uses tus claves reales de Binance, solo las de Testnet.
BINANCE_API_KEY=
BINANCE_API_SECRET=

SYMBOL=BTC/USDT
TIMEFRAME=15m
# Lista de pares a evaluar/operar (separados por coma). Si se deja vacío,
# se usa solo SYMBOL. Incluye bStocks (acciones tokenizadas de Binance, ej.
# NVDAB/USDT, MSFTB/USDT, TSLAB/USDT, CRCLB/USDT, MUB/USDT, SNDKB/USDT) si
# quieres exposición a TradFi sin salir de tu cuenta de Binance — son pares
# spot normales, no necesitan configuración aparte. Revisa disponibilidad en
# Binance Testnet antes de usarlas en `paper` (ver README).
CRYPTO_WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,NVDAB/USDT,MSFTB/USDT

# ── Alpaca (TradFi: acciones/ETFs) — https://app.alpaca.markets/paper ──────
# Crea una cuenta gratuita de PAPER TRADING (no dinero real) y genera aquí
# tu API key/secret. Deja vacío STOCK_WATCHLIST si no quieres usar TradFi.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
STOCK_WATCHLIST=AAPL,MSFT,SPY,QQQ,GLD
STOCK_TIMEFRAME=1d

# Modo: siempre en testnet/sandbox/paper mientras se valida la estrategia
SANDBOX=true

# Gestión de riesgo (se aplica por separado a cada bróker/cuenta)
INITIAL_BALANCE=1000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
ATR_MULTIPLIER=2.0
REWARD_RISK_RATIO=1.5
# Máximo de posiciones abiertas simultáneas, sumando cripto + TradFi
MAX_OPEN_POSITIONS=3

# Parámetros de estrategia
FAST_MA=20
SLOW_MA=50
RSI_PERIOD=14
RSI_OVERSOLD=35
RSI_OVERBOUGHT=65

# Bucle de paper trading
LOOP_INTERVAL_SECONDS=60
