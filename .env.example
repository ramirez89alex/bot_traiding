# Copia este archivo a .env y completa tus valores. Nunca subas .env al repositorio.

# Claves de la API de Binance TESTNET (https://testnet.binance.vision)
# Para paper trading NO uses tus claves reales de Binance.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Mercado y temporalidad
SYMBOL=BTC/USDT
TIMEFRAME=15m

# Modo: siempre en testnet/sandbox mientras se valida la estrategia
SANDBOX=true

# Gestión de riesgo
INITIAL_BALANCE=1000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
ATR_MULTIPLIER=2.0
REWARD_RISK_RATIO=1.5

# Parámetros de estrategia
FAST_MA=20
SLOW_MA=50
RSI_PERIOD=14
RSI_OVERSOLD=35
RSI_OVERBOUGHT=65

# Bucle de paper trading
LOOP_INTERVAL_SECONDS=60
